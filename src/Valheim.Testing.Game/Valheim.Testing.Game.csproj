<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>0.3.0</Version><Authors>Tys von Gaza</Authors><Copyright>Copyright (c) 2026 Tys von Gaza</Copyright><PackageLicenseFile>LICENSE</PackageLicenseFile><PackageReadmeFile>README.md</PackageReadmeFile><Description>Fixtures and typed assertions for Valheim integration tests using the shared CLI transport. Unofficial community tooling; not affiliated with or endorsed by Iron Gate or Coffee Stain. Valheim is a trademark of Iron Gate AB.</Description>
    <PackageProjectUrl>https://github.com/tvongaza/ValheimTesting</PackageProjectUrl><RepositoryUrl>https://github.com/tvongaza/ValheimTesting.git</RepositoryUrl><RepositoryType>git</RepositoryType><PackageTags>valheim;modding;testing;bepinex;valheimcli</PackageTags>
  </PropertyGroup>
  <!-- The Cli version has one home, cli-dependency.json's packageVersion (#683): the transport bootstrap-cli.cs packs under it. -->
  <PropertyGroup><ValheimTestingCliVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../cli-dependency.json')), '"packageVersion"\s*:\s*"([^"]+)"').Groups[1].Value)</ValheimTestingCliVersion></PropertyGroup>
  <ItemGroup><PackageReference Include="Valheim.Testing.Cli" Version="[$(ValheimTestingCliVersion)]" /><ProjectReference Include="../Valheim.Testing/Valheim.Testing.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Valheim.Testing.Tests" /><InternalsVisibleTo Include="Valheim.Testing.GameSessions" /><InternalsVisibleTo Include="Valheim.Testing.NativeSmoke" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/SmokeWorld/VTDefaultSmoke/*">
      <LogicalName>Valheim.Testing.Game.SmokeWorld.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fixtures/SmokeCharacter/vtseedclean.fch" LogicalName="Valheim.Testing.Game.SmokeCharacter.vtseedclean.fch" />
  </ItemGroup>
  <ItemGroup><None Include="../../LICENSE" Pack="true" PackagePath="" /><None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" /><None Include="../../README.md" Pack="true" PackagePath="README.md" /></ItemGroup>
</Project>
