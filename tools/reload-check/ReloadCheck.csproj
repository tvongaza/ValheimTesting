<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><RollForward>Major</RollForward><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <!-- ReloadProbe/ is the game-side probe (net48, built against a game install); none of its files belong to this driver. -->
  <PropertyGroup><DefaultItemExcludes>$(DefaultItemExcludes);ReloadProbe/**</DefaultItemExcludes></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/Valheim.Testing.Game/Valheim.Testing.Game.csproj" /></ItemGroup>
</Project>
