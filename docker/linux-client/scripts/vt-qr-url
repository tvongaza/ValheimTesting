#!/bin/bash
# Print the Steam login challenge URL from the LAST text QR code in a DepotDownloader log (it draws the code with
# block characters only). Renders the block art to an image and decodes it with zbarimg. Exit 1 when none decodes.
set -euo pipefail
LOG="$1"; OUT=$(mktemp -d)
# The block art follows the last "sign in with this QR code:" line; each module is two characters wide.
awk '/sign in with this QR code:/{n++; delete l; c=0; stop=0; next} n && !stop { if ($0 ~ /^[ █▀▄]+$/) l[c++]=$0; else if (c>0) stop=1 } END{for(i=0;i<c;i++) print l[i]}' "$LOG" > "$OUT/art.txt"
[ -s "$OUT/art.txt" ] || { echo "vt-qr-url: no QR code in $LOG" >&2; exit 1; }
python3 - "$OUT/art.txt" "$OUT/qr.pbm" <<'PY'
import sys
rows = [l.rstrip("\n") for l in open(sys.argv[1], encoding="utf-8")]
w = max(len(r) for r in rows)
# Half-block characters carry two vertical modules per text row; full blocks and spaces one per row pair.
px = []
for r in rows:
    r = r.ljust(w)
    top = [1 if ch in "█▀" else 0 for ch in r]
    bot = [1 if ch in "█▄" else 0 for ch in r]
    px.append(top); px.append(bot)
h = len(px)
with open(sys.argv[2], "w") as f:
    f.write(f"P1\n{w} {h}\n")
    for row in px: f.write(" ".join(map(str, row)) + "\n")
PY
convert "$OUT/qr.pbm" -scale 800% -bordercolor white -border 40 "$OUT/qr.png"
zbarimg --quiet --raw "$OUT/qr.png" 2>/dev/null | grep -m1 '^https://s.team/' || { echo "vt-qr-url: QR did not decode" >&2; exit 1; }
