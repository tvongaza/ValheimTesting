<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>valheim-test</ToolCommandName>
    <PackageId>Valheim.Testing.NativeSmoke</PackageId>
    <Version>0.1.0-preview.3</Version>
    <Authors>Tys von Gaza</Authors>
    <Copyright>Copyright (c) 2026 Tys von Gaza</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Disposable, strictly pinned native Valheim mod-load smoke runner.</Description>
    <PackageProjectUrl>https://github.com/tvongaza/ValheimTesting</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tvongaza/ValheimTesting.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SessionAdapter/**/*.cs" />
    <ProjectReference Include="../../src/Valheim.Testing.Game/Valheim.Testing.Game.csproj" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <EmbeddedResource Include="SessionAdapter/Plugin.cs" LogicalName="NativeSmoke.Adapter.Plugin.cs" />
    <EmbeddedResource Include="../../toolkit-versions.json" LogicalName="toolkit-versions.json" />
    <EmbeddedResource Include="../../src/Valheim.Testing.Adapter/Adapter/TestExtension.cs" LogicalName="NativeSmoke.Adapter.TestExtension.cs" />
    <EmbeddedResource Include="../../src/Valheim.Testing.Adapter/Adapter/Members.cs" LogicalName="NativeSmoke.Adapter.Members.cs" />
    <EmbeddedResource Include="../../tools/game-references/Valheim.GameReferences.props" LogicalName="NativeSmoke.Adapter.Valheim.GameReferences.props" />
    <EmbeddedResource Include="../../tools/game-references/Valheim.GameReferences.targets" LogicalName="NativeSmoke.Adapter.Valheim.GameReferences.targets" />
  </ItemGroup>
</Project>
