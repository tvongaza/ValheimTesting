<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Valheim.Testing.GameSessions" Version="[0.3.0]" />
    <AssemblyMetadata Include="SessionDirectory" Value="$(MSBuildProjectDirectory)" />
    <None Include="sample-plan.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sample-hosted-plan.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
