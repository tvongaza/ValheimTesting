<Project Sdk="Microsoft.NET.Sdk">
  <!-- The external runner: a normal .NET 10 program. No game assemblies; it drives the game through ValheimCLI. -->
  <PropertyGroup><OutputType>Exe</OutputType><RollForward>Major</RollForward><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <!-- Sessions (GameSession, ServerActor, PinnedServerRun) are Valheim.Testing.GameSessions'; it brings the Valheim.Testing.Game it was built with. -->
  <ItemGroup Condition="'$(GameSessionsPackageVersion)' == ''"><ProjectReference Include="../../../src/Valheim.Testing.GameSessions/Valheim.Testing.GameSessions.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(GameSessionsPackageVersion)' != ''"><PackageReference Include="Valheim.Testing.GameSessions" Version="[$(GameSessionsPackageVersion)]" /></ItemGroup>
  <Target Name="NeedsGameSessionsPackage" BeforeTargets="CollectPackageReferences" Condition="'$(ToolkitPackageVersion)' != '' And '$(GameSessionsPackageVersion)' == ''">
    <Error Text="This project runs game sessions: build it from packages with -p:GameSessionsPackageVersion=VERSION (a published Valheim.Testing.GameSessions, which brings its Valheim.Testing.Game); ToolkitPackageVersion alone names only the Game package." />
  </Target>
</Project>
