<Project Sdk="Microsoft.NET.Sdk">
  <!-- A targeted native regression runner: a normal .NET 10 program that drives the game through ValheimCLI. Scenario.cs is the shareable part; the manifest holds the environment. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><RollForward>Major</RollForward><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ToolkitPackageVersion Condition="'$(ToolkitPackageVersion)' == ''">0.1.0-preview.44</ToolkitPackageVersion></PropertyGroup>
  <ItemGroup><PackageReference Include="Valheim.Testing.Game" Version="[$(ToolkitPackageVersion)]" /></ItemGroup>
</Project>
