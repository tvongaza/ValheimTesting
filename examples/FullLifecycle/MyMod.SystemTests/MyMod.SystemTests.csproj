<Project Sdk="Microsoft.NET.Sdk">
  <!-- The external runner: a normal .NET 10 program. No game assemblies; it drives the game through ValheimCLI. -->
  <PropertyGroup><OutputType>Exe</OutputType><RollForward>Major</RollForward><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup Condition="'$(ToolkitPackageVersion)' == ''"><ProjectReference Include="../../../src/Valheim.Testing.Game/Valheim.Testing.Game.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(ToolkitPackageVersion)' != ''"><PackageReference Include="Valheim.Testing.Game" Version="[$(ToolkitPackageVersion)]" /></ItemGroup>
  <!-- MyMod's declared content for the content-census scenario, shipped inside the runner. -->
  <ItemGroup><EmbeddedResource Include="content-expectations.json" LogicalName="MyMod.SystemTests.content-expectations.json" /></ItemGroup>
</Project>
