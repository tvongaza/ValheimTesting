{
  "metadata": [{
    "src": [
      {
        "files": ["ValheimTesting.Api.sln"],
        "src": "."
      }
    ],
    "dest": "../../artifacts/docs-site/api",
    "filter": "filter.yml"
  }],
  "build": {
    "content": [
      { "src": "../../artifacts/docs-site", "files": ["**/*.md", "**/toc.yml", "api/**.yml"] }
    ],
    "resource": [
      { "files": ["logo.svg"] },
      { "src": "../../artifacts/docs-site", "files": ["llms.txt"] }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "ValheimTesting",
      "_appTitle": "ValheimTesting docs",
      "_appLogoPath": "logo.svg",
      "_appFaviconPath": "logo.svg",
      "_enableSearch": true
    }
  }
}
