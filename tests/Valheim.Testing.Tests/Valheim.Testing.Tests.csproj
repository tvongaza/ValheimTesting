<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
    <!-- dev-loop.cs is a file-based script; compiled here without its top-level entry point. -->
    <DefineConstants>$(DefineConstants);DEV_LOOP_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Valheim.Testing.Game/Valheim.Testing.Game.csproj" />
    <ProjectReference Include="../../src/Valheim.Testing.GameSessions/Valheim.Testing.GameSessions.csproj" />
    <ProjectReference Include="../../src/Valheim.Testing.NativeSmoke/Valheim.Testing.NativeSmoke.csproj" />
    <ProjectReference Include="../../tools/regression-bundle/RegressionBundle.csproj" />
    <ProjectReference Include="../Valheim.Testing.ProcessSignalProbe/Valheim.Testing.ProcessSignalProbe.csproj" />
    <!-- The adapter package's helpers that use no game types; the rest of its source compiles in Valheim.Testing.Adapter.CompileCheck. -->
    <Compile Include="../../src/Valheim.Testing.Adapter/Adapter/Members.cs;../../src/Valheim.Testing.Adapter/Adapter/FixtureGate.cs" LinkBase="Adapter" />
    <!-- Compiled twice at test time against a working BepInEx stub, as a ScriptEngine reload loads it twice. -->
    <EmbeddedResource Include="../../src/Valheim.Testing.Adapter/Adapter/QuitLogFlush.cs" LogicalName="Adapter.QuitLogFlush.cs" />
    <Compile Include="../../tools/dev-loop/dev-loop.cs" Link="DevLoop/dev-loop.cs" />
    <!-- The ObserveCheck example's flow without its CliTransport entry point (ObserveCheckTests). -->
    <Compile Include="../../examples/ObserveCheck/ObserveCheck.cs" Link="ObserveCheck/ObserveCheck.cs" />
    <!-- Compiles small ValheimCLI-shaped assemblies at test time for the capability manifest tests; none is committed. -->
    <!-- Real native dumps and the manifests the capture writes for them; byte-exact (see the directory's .gitattributes). -->
    <None Include="Fixtures/WorldDump/*.csv;Fixtures/WorldDump/*.json;Fixtures/Observe/*.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" /><PackageReference Include="xunit" Version="2.8.1" /><PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>
</Project>
