<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The mod's game-side test adapter: installed only in test runtimes, next to the mod and ValheimCLI. It compiles the
    toolkit's adapter source (the Valheim.Testing.Adapter package; linked from this repository here) against the game
    (-p:ValheimPath=, as the mod) and the exact ValheimCLI core installed in the test runtime (-p:CliDll=).
  -->
  <Import Project="../../../tools/game-references/Valheim.GameReferences.props" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><LangVersion>10</LangVersion><Nullable>enable</Nullable>
    <DebugType>embedded</DebugType><CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>MyMod.TestAdapter</AssemblyName><Version>0.1.0</Version>
    <UseValheimCli>true</UseValheimCli>
    <DefineConstants>$(DefineConstants);VALHEIM_TESTING_REVIEW_CLIP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Valheim.Testing.Adapter/Adapter/*.cs" LinkBase="ValheimTestingAdapter" />
    <!-- The adapter helpers' collider sampling (ZoneTerrain) needs Unity's physics module. -->
    <ValheimReference Include="UnityEngine.PhysicsModule" />
    <ValheimReference Include="UnityEngine.UIModule" />
    <ValheimReference Include="UnityEngine.ImageConversionModule" />
  </ItemGroup>
  <Import Project="../../../tools/game-references/Valheim.GameReferences.targets" />
</Project>
