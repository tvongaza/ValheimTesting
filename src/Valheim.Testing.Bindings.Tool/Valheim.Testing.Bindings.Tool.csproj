<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The valheim-bindings command as a .NET tool, for a mod's CI: install it with `dotnet tool install` and run it on the
    built mod before any native run. The check itself is the Valheim.Testing.Bindings library, which the tool bundles
    together with Mono.Cecil (tools carry their dependencies). RollForward lets it run on a newer SDK's runtime.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool><ToolCommandName>valheim-bindings</ToolCommandName>
    <Version>0.1.0-preview.1</Version><Authors>Tys von Gaza</Authors><Copyright>Copyright (c) 2026 Tys von Gaza</Copyright><PackageLicenseFile>LICENSE</PackageLicenseFile><PackageReadmeFile>README.md</PackageReadmeFile><Description>valheim-bindings: a .NET tool that checks offline whether a built mod's references into assembly_valheim and other game assemblies still bind, for a mod's CI before any native run. Unofficial community tooling; not affiliated with or endorsed by Iron Gate or Coffee Stain. Valheim is a trademark of Iron Gate AB.</Description>
    <PackageId>Valheim.Testing.Bindings.Tool</PackageId><PackageProjectUrl>https://github.com/tvongaza/ValheimTesting</PackageProjectUrl><RepositoryUrl>https://github.com/tvongaza/ValheimTesting.git</RepositoryUrl><RepositoryType>git</RepositoryType><PackageTags>valheim;modding;testing;bepinex;cecil;ci;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Valheim.Testing.Bindings/Valheim.Testing.Bindings.csproj" /></ItemGroup>
  <ItemGroup><None Include="../../LICENSE" Pack="true" PackagePath="" /><None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" /><None Include="../../docs/packages/Valheim.Testing.Bindings.md" Pack="true" PackagePath="README.md" /></ItemGroup>
</Project>
