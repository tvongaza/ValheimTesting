<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Valheim.Testing.Game/Valheim.Testing.Game.csproj" />
    <ProjectReference Include="../../examples/NativeSmoke/NativeSmoke.csproj" />
    <ProjectReference Include="../Valheim.Testing.ProcessSignalProbe/Valheim.Testing.ProcessSignalProbe.csproj" />
    <!-- The adapter package's helpers that use no game types; the rest of its source compiles in Valheim.Testing.Adapter.CompileCheck. -->
    <Compile Include="../../src/Valheim.Testing.Adapter/Adapter/Members.cs;../../src/Valheim.Testing.Adapter/Adapter/KeyValueReply.cs;../../src/Valheim.Testing.Adapter/Adapter/FixtureGate.cs" LinkBase="Adapter" />
    <!-- Compiled twice at test time against a working BepInEx stub, as a ScriptEngine reload loads it twice. -->
    <EmbeddedResource Include="../../src/Valheim.Testing.Adapter/Adapter/QuitLogFlush.cs" LogicalName="Adapter.QuitLogFlush.cs" />
    <Compile Include="../../examples/NativeSmoke/SmokeOutput.cs" Link="NativeSmoke/SmokeOutput.cs" />
    <Compile Include="../../examples/NativeSmoke/CopiesCommand.cs" Link="NativeSmoke/CopiesCommand.cs" />
    <Compile Include="../../examples/NativeSmoke/EnvCommand.cs" Link="NativeSmoke/EnvCommand.cs" />
    <Compile Include="../../examples/NativeSmoke/SmokeInputs.cs" Link="NativeSmoke/SmokeInputs.cs" />
    <Compile Include="../../examples/NativeSmoke/SmokeProject.cs" Link="NativeSmoke/SmokeProject.cs" />
    <!-- Compiles small ValheimCLI-shaped assemblies at test time for the capability manifest tests; none is committed. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" /><PackageReference Include="xunit" Version="2.8.1" /><PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>
</Project>
