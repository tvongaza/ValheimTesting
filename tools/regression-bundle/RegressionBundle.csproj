<Project Sdk="Microsoft.NET.Sdk">
  <!-- A maintainer tool, not a package: makes a scrubbed, reproducible public bundle of a targeted native regression for review; publishes nothing. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><RollForward>Major</RollForward><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable></PropertyGroup>
  <!-- Against this checkout's Game by default; -p:ToolkitPackageVersion=<version> builds against the published package the run used. -->
  <ItemGroup Condition="'$(ToolkitPackageVersion)' == ''"><ProjectReference Include="../../src/Valheim.Testing.Game/Valheim.Testing.Game.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(ToolkitPackageVersion)' != ''"><PackageReference Include="Valheim.Testing.Game" Version="[$(ToolkitPackageVersion)]" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Valheim.Testing.Tests" /></ItemGroup>
</Project>
