#!/bin/bash
# Stop the client vt-launch-valheim started, and only that process: vt-stop-game [seconds]   (TERM, then KILL after
# <seconds>, default 30). Its identity (PID and start time) comes from the launch; a PID now used by another process is
# left alone. Exit 0 once the process is proven gone (or was already gone), 1 when it cannot be proven.
set -uo pipefail
S="${1:-30}"; IDF=/home/steam/valheim.identity
read -r P ST < "$IDF" 2>/dev/null && [ -n "${ST-}" ] || { echo "vt-stop-game: no launched client recorded"; exit 0; }
started() { local s; s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1; s=${s##*) }; set -- $s; [ "$1" != Z ] && echo "${20}"; }
ours() { [ "$(started "$P")" = "$ST" ]; }
ours || { echo "vt-stop-game: the launched client (PID $P) is not running"; rm -f "$IDF"; exit 0; }
kill "$P" 2>/dev/null
for _ in $(seq 1 "$S"); do ours || { echo "vt-stop-game: client $P stopped"; rm -f "$IDF"; exit 0; }; sleep 1; done
kill -9 "$P" 2>/dev/null
for _ in 1 2 3 4 5; do ours || { echo "vt-stop-game: client $P killed"; rm -f "$IDF"; exit 0; }; sleep 1; done
echo "vt-stop-game: client $P still running"; exit 1
