<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <!-- Types keep the Valheim.Testing.Game namespace for one preview after the split (#289), so callers only add this package. -->
    <RootNamespace>Valheim.Testing.Game</RootNamespace>
    <Version>0.1.0-preview.1</Version><Authors>Tys von Gaza</Authors><Copyright>Copyright (c) 2026 Tys von Gaza</Copyright><PackageLicenseFile>LICENSE</PackageLicenseFile><PackageReadmeFile>README.md</PackageReadmeFile><Description>Game sessions for Valheim mod tests: one or more real game processes in roles (dedicated server, clients, a hosting client) on this machine or on others reached over SSH or a container, with an environment inventory, host locks, Steam-account leases, a run journal and recovery. Built on Valheim.Testing.Game. Unofficial community tooling; not affiliated with or endorsed by Iron Gate or Coffee Stain. Valheim is a trademark of Iron Gate AB.</Description>
    <PackageProjectUrl>https://github.com/tvongaza/ValheimTesting</PackageProjectUrl><RepositoryUrl>https://github.com/tvongaza/ValheimTesting.git</RepositoryUrl><RepositoryType>git</RepositoryType><PackageTags>valheim;modding;testing;bepinex;valheimcli;multiplayer</PackageTags>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Valheim.Testing.Game/Valheim.Testing.Game.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Valheim.Testing.Tests" /></ItemGroup>
  <ItemGroup><None Include="../../LICENSE" Pack="true" PackagePath="" /><None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" /><None Include="../../docs/packages/Valheim.Testing.GameSessions.md" Pack="true" PackagePath="README.md" /></ItemGroup>
  <!-- This package uses Valheim.Testing.Game's internals (InternalsVisibleTo), so it depends on exactly the Game it was built
       with: [version], not NuGet's default minimum. -->
  <Target Name="ExactGameDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ExactProjectReferenceVersions Include="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_ExactProjectReferenceVersions)" />
    </ItemGroup>
  </Target>
</Project>
