{
  "title": "<Mod> #<issue>: <what the regression checks>",
  "issue": "https://github.com/<owner>/<mod>/issues/<n>",
  "summary": "<two sentences: what the scenario does and what the fix changes>",
  "environment": "<the run's regression.json>",
  "runner": "ExampleModMarkRegression",
  "sources": ["<your copy of TargetedRegression>/Program.cs", "<your copy of TargetedRegression>/Scenario.cs"],
  "toolkit": { "packageId": "Valheim.Testing.GameSessions", "package": "<the published GameSessions version the run used, or newer>" },
  "plugins": ["example.examplemod", "example.examplemod.testadapter"],
  "arms": {
    "parent": { "evidence": "<new-evidence-parent>", "expect": "fail", "failingStep": "<the step the fix changes>" },
    "candidate": { "evidence": "<new-evidence-candidate>", "expect": "pass" }
  },
  "limitations": ["<what this run does not establish>"]
}
