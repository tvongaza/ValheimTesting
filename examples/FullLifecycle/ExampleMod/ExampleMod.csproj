<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The example mod: a BepInEx plugin. Its decision is ModWithTests' DrySiteRule, compiled from that same file.
    It compiles against YOUR game install, never in this repository or its CI: pass -p:ValheimPath=<the game folder>
    or set VALHEIM_PATH. The references come from tools/game-references; a mod keeps its own copy of those two files.
  -->
  <Import Project="../../../tools/game-references/Valheim.GameReferences.props" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><LangVersion>10</LangVersion><Nullable>enable</Nullable>
    <DebugType>embedded</DebugType><CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>ExampleMod</AssemblyName><Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup><Compile Include="../../ModWithTests/MyMod/DrySiteRule.cs" Link="DrySiteRule.cs" /></ItemGroup>
  <Import Project="../../../tools/game-references/Valheim.GameReferences.targets" />
</Project>
