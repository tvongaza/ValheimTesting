<Project>
  <!-- Every project and file-based script in this repository builds with warnings as errors, so a new compiler or analyzer
       warning fails the build where it appears instead of piling up in CI annotations. NuGet vulnerability advisories
       (NU1901-NU1904) stay warnings: they come from the feed, not from this code, as in scripts/consumer.cs. A project or
       folder with its own Directory.Build.props imports this one. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
